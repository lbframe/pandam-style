{
  "name": "@pandamstyle/compiler",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "PandamStyle compiler and revision-based project service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lbframe/pandam-style.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "module": "./lib/index.mjs",
  "types": "./types/index.d.ts",
  "bin": {
    "pms-build": "./bin/pms-build.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.mjs"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "import": "./lib/config.mjs"
    },
    "./host": {
      "types": "./types/host.d.ts",
      "import": "./lib/host.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "types",
    "LICENSE",
    "ATTRIBUTIONS.md",
    "LICENSES",
    "docs/architecture/phase-4-derived-source-provenance.md",
    "docs/architecture/phase-4-engine-absorption-map.md",
    "README.md"
  ],
  "scripts": {
    "build": "rollup --config ./rollup.config.mjs",
    "prebuild": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pandamstyle/core": "0.1.0-alpha.1",
    "@babel/core": "^7.26.8",
    "@babel/helper-module-imports": "^7.25.9",
    "@babel/parser": "^7.28.5",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/traverse": "^7.26.8",
    "@babel/types": "^7.26.8",
    "@csstools/css-tokenizer": "^3.0.3",
    "postcss-value-parser": "^4.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.8",
    "@babel/preset-flow": "^7.26.8",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "babel-plugin-syntax-hermes-parser": "^0.36.1",
    "rollup": "^4.59.0"
  }
}
