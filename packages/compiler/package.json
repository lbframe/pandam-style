{
  "name": "@pandamstyle/compiler",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "PandamStyle compiler and revision-based project service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lbframe/pandam-style.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "module": "./lib/index.mjs",
  "types": "./types/index.d.ts",
  "bin": {
    "pms-build": "./bin/pms-build.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.mjs"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "import": "./lib/config.mjs"
    },
    "./host": {
      "types": "./types/host.d.ts",
      "import": "./lib/host.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "types",
    "LICENSE",
    "ATTRIBUTIONS.md",
    "LICENSES",
    "docs/architecture/phase-4-derived-source-provenance.md",
    "docs/architecture/phase-4-engine-absorption-map.md",
    "README.md"
  ],
  "scripts": {
    "build": "rollup --config ./rollup.config.mjs",
    "prebuild": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pandamstyle/core": "0.1.0-alpha.1",
    "@babel/core": "^8.0.9",
    "@babel/helper-module-imports": "^8.0.0",
    "@babel/parser": "^8.0.8",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.8",
    "@csstools/css-tokenizer": "^4.0.2",
    "baseline-browser-mapping": "2.11.32",
    "browserslist": "4.29.4",
    "caniuse-lite": "1.0.30001819",
    "electron-to-chromium": "1.5.464",
    "postcss-value-parser": "^4.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-flow": "^8.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "babel-plugin-syntax-hermes-parser": "^0.37.0",
    "rollup": "^4.65.0"
  }
}
