{
  "kind": "pandamstyle-subfeature-reviews",
  "schemaVersion": 1,
  "compatData": {
    "bcdVersion": "8.1.6"
  },
  "policy": "Every BCD subfeature of a path a construct is evaluated on is either extracted as its own feature key, reviewed here as not expressible in CSS text (`not-css-syntax`, the construct's statement governs), or `fail-closed` (the construct evaluates as `unknown` on an engine where the subfeature is not native and the construct is). targets-subfeature-test.js derives the subfeature list from the bundled data and fails on any path that is none of the three.",
  "reviews": [
    {
      "disposition": "not-css-syntax",
      "rationale": "Support stated for a layout context: the formatting context of the element or of its container (block, flex, grid, multi-column, paged, absolutely positioned, table). Other declarations, often on other elements and in other files, decide that context; the text of the emitted declaration does not, so the property's own statement is the one evaluated.",
      "paths": [
        "css.properties.align-content.context_block",
        "css.properties.align-content.context_flex",
        "css.properties.align-content.context_grid",
        "css.properties.align-content.context_multicol",
        "css.properties.align-items.context_flex",
        "css.properties.align-items.context_grid",
        "css.properties.align-self.context_flex",
        "css.properties.align-self.context_grid",
        "css.properties.align-self.context_position_absolute",
        "css.properties.break-after.multicol_context",
        "css.properties.break-after.paged_context",
        "css.properties.break-inside.multicol_context",
        "css.properties.break-inside.paged_context",
        "css.properties.column-gap.flex_context",
        "css.properties.column-gap.grid_context",
        "css.properties.column-gap.multicol_context",
        "css.properties.gap.flex_context",
        "css.properties.gap.grid_context",
        "css.properties.gap.multicol_context",
