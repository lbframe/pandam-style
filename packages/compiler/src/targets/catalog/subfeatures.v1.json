        "css.selectors.first-letter.dutch_ij_digraph"
      ]
    },
    {
      "disposition": "not-css-syntax",
      "rationale": "Support that depends on the format of a referenced resource (an SVG image or mask). The resource file decides it; the CSS only references it.",
      "paths": [
        "css.properties.background-image.svg_images",
        "css.properties.mask-image.svg_masks"
      ]
    },
    {
      "disposition": "not-css-syntax",
      "rationale": "How an engine processes CSS: selector matching boundaries and privacy restrictions, DOM APIs, interpolation of animated values, shorthand expansion, inherited color schemes, the meaning of existing values in vertical writing modes, and dropping an `@font-face` source it rejects (each source's own `format()`/`tech()` forms are extracted). No emitted syntax selects or excludes the behavior.",
      "paths": [
        "css.at-rules.font-face.src.drop_invalid_item",
        "css.at-rules.media.prefers-color-scheme.respects-inherited-scheme",
        "css.properties.animation.animation-timeline_included",
        "css.properties.caption-side.writing-mode_relative_values",
        "css.properties.flex-grow.less_than_zero_animate",
        "css.properties.transition.gradients_can_animate",
        "css.selectors.active.top-layer_ancestor_matching_boundary",
        "css.selectors.focus-within.top-layer_ancestor_matching_boundary",
        "css.selectors.hover.top-layer_ancestor_matching_boundary"
      ]
    }
  ]
