{
  "kind": "pandamstyle-subfeature-reviews",
  "schemaVersion": 1,
  "compatData": {
    "bcdVersion": "8.1.6"
  },
  "policy": "Every BCD subfeature of a path an emitted construct is evaluated on, and every css.types path a value can reach, is extracted as its own feature key, native on every engine at the minimum floor (decision O13; derived from the bundled data, never listed here), or reviewed here: not-css-syntax (not a way of writing CSS: the construct's own statement is evaluated) or base-form-unaffected (only where no detector is possible and the base form is provably unaffected). targets-subfeature-test.js derives the list from the bundled data and fails on any path that is none of these, or on a review that is stale.",
  "reviews": [
    {
      "disposition": "not-css-syntax",
      "rationale": "Support stated for a layout context: the formatting context of the element or of its container (block, flex, grid, multi-column, paged, absolutely positioned, table). Other declarations, often on other elements and in other files, decide that context; the text of the emitted declaration does not, so the property's own statement is the one evaluated.",
      "paths": [
        "css.properties.align-content.context_block",
        "css.properties.align-content.context_multicol",
        "css.properties.align-items.context_flex",
        "css.properties.align-self.context_flex",
        "css.properties.align-self.context_position_absolute",
        "css.properties.break-after.multicol_context",
        "css.properties.justify-content.flex_context",
        "css.properties.justify-items.block_context",
        "css.properties.justify-self.block_context",
        "css.properties.justify-self.position_absolute_context",
        "css.properties.position.position_sticky_table_elements",
        "css.properties.resize.block_level_support"
      ]
    },
    {
      "disposition": "not-css-syntax",
      "rationale": "Support stated for an element type: SVG, HTML, replaced, form-control, list, top-layer or parentless elements. Markup decides which element a class applies to; emitted CSS does not contain it.",
      "paths": [
        "css.properties.appearance.base-select.listbox",
        "css.properties.appearance.base-select.multiple_dropdown",
        "css.properties.appearance.base-select.single_dropdown",
        "css.properties.direction.vertical_slider_direction",
        "css.properties.display.contents.contents_unusual",
        "css.properties.display.contents.focusable_elements",
        "css.properties.display.list-item.legend-support",
        "css.properties.display.none.option_is_hidden",
        "css.properties.filter.svg_elements",
        "css.properties.mix-blend-mode.svg_elements",
        "css.properties.overflow-x.replaced_elements",
        "css.properties.overflow-y.replaced_elements",
        "css.properties.overflow.replaced_elements",
        "css.properties.white-space.svg_elements",
        "css.properties.writing-mode.vertical_oriented_form_controls",
        "css.selectors.active.non_a_elements",
        "css.selectors.backdrop.fullscreen",
        "css.selectors.backdrop.popover",
        "css.selectors.first-child.no_parent_required",
        "css.selectors.first-letter.svg_text_element",
        "css.selectors.first-line.svg_text_element",
        "css.selectors.fullscreen.all_elements",
        "css.selectors.hover.all_elements",
        "css.selectors.last-child.no_parent_required",
        "css.selectors.nth-child.no_parent_required",
        "css.selectors.nth-last-child.no_parent_required",
        "css.selectors.only-child.no_parent_required"
      ]
    },
    {
      "disposition": "not-css-syntax",
      "rationale": "Support that depends on the text the rule applies to: its language and script (hyphenation dictionaries, case mappings, digraphs). The document content decides it, not the emitted CSS.",
      "paths": [
