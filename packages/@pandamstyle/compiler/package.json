{
  "name": "@pandamstyle/compiler",
  "version": "0.1.0",
  "private": false,
  "description": "PandamStyle compiler: the StyleX fork engine plus the PandamStyle registry, policy, recipes and build pipeline.",
  "license": "MIT",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "bin": {
    "pms-build": "./bin/pms-build.js"
  },
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./vite": {
      "import": "./lib/vite.mjs",
      "require": "./lib/vite.js",
      "default": "./lib/vite.js"
    },
    "./runtime": {
      "import": "./lib/runtime.mjs",
      "require": "./lib/runtime.cjs",
      "default": "./lib/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*",
    "bin/*"
  ],
  "scripts": {
    "build": "rollup --config ./rollup.config.mjs",
    "prebuild": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@babel/core": "^7.26.8",
    "@babel/helper-module-imports": "^7.25.9",
    "@babel/parser": "^7.28.5",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/traverse": "^7.26.8",
    "@babel/types": "^7.26.8",
    "@dual-bundle/import-meta-resolve": "^4.1.0",
    "@stylexjs/shared": "0.19.1",
    "@stylexjs/stylex": "0.19.1",
    "postcss-value-parser": "^4.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "babel-plugin-syntax-hermes-parser": "^0.36.1",
    "rollup": "^4.59.0"
  },
  "typesNote": "Types are NOT shipped in this batch: generated .d.ts is a remaining gap, so no types export is declared."
}
