{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-evolution-scope-findings.v1.schema.json",
  "title": "CE-00.2 scope findings",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "core-evolution-scope-findings"
    },
    "task": {
      "const": "CE-00.2"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SF-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["registry-scope", "compiler-defect", "measurement-data"]
          },
          "owner": {
            "type": "string",
            "pattern": "^CE-[0-9]{2}\\.[0-9]$"
          },
          "issue": {
            "type": "integer"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "handoff": {
            "type": "string",
            "minLength": 1
          },
          "profileImpact": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "owner",
          "issue",
          "evidence",
          "handoff"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "task", "policy", "findings"]
}
