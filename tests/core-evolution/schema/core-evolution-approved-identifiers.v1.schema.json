{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-evolution-approved-identifiers.v1.schema.json",
  "title": "CE-00.2 approved consumer identifiers",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "core-evolution-approved-identifiers"
    },
    "task": {
      "const": "CE-00.2"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^-{0,2}[A-Za-z][A-Za-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "custom-property",
              "font-family",
              "animation-name",
              "layer",
              "invalid-value"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": ["identifier", "kind", "reason"]
      }
    }
  },
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "task", "policy", "identifiers"]
}
