{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-evolution-corpus-accounting.v1.schema.json",
  "title": "CE-00.2 corpus declaration accounting",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "core-evolution-corpus-accounting"
    },
    "task": {
      "const": "CE-00.2"
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1
    },
    "totals": {
      "type": "object"
    },
    "stylesheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "fixtureId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "counts": {
            "type": "object"
          },
          "declarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9:-]+#[0-9]{3,4}$"
                },
                "property": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "important": {
                  "const": true
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "layer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "atRules": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "keyframes": {
                      "const": true
                    },
                    "descriptor": {
                      "enum": ["font-face"]
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "pseudoClasses": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "pseudoElements": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "attributes": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "redactedAttributes": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "redactedSelectorParts": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "additionalProperties": false,
                      "required": []
                    },
                    "nestedRules": {
                      "type": "integer",
                      "minimum": 2
                    }
                  },
                  "additionalProperties": false,
                  "required": []
                },
                "denominator": {
                  "enum": ["alpha1-baseline", "outside-alpha1-baseline"]
                },
                "excludedReason": {
                  "enum": [
                    "custom-property",
                    "keyframes-frame",
                    "layer-outside-measured-input"
                  ]
                },
                "redactions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "url",
                          "string",
                          "email",
                          "uri",
                          "opaque",
                          "non-ascii-text",
                          "identifier",
                          "at-rule-params",
                          "token"
                        ]
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^(hmac-)?sha256:[0-9a-f]{64}$"
                      }
                    },
                    "additionalProperties": false,
                    "required": ["kind", "digest"]
                  }
                },
                "alpha1": {
                  "type": "object",
                  "properties": {
                    "bucket": {
                      "enum": [
                        "category",
                        "structural-ok",
                        "structural-forbidden",
                        "composite",
                        "unsupported"
                      ]
                    },
                    "outcome": {
                      "enum": ["expressible", "composite-rewrite", "gap"]
                    },
                    "gapKind": {
                      "enum": ["absent-property", "out-of-domain"]
                    }
                  },
                  "additionalProperties": false,
                  "required": ["bucket", "outcome"]
                },
                "composite": {
                  "type": "object",
                  "properties": {
                    "rewrite": {
                      "enum": ["background-color-only", "full-longhand-reset"]
                    },
                    "basis": {
                      "enum": [
                        "color",
                        "custom-property-color",
                        "unresolved-custom-property",
                        "none-keyword",
                        "other"
                      ]
                    },
                    "longhands": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "longhandsNotAdmitted": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "rewrite",
                    "basis",
                    "longhands",
                    "longhandsNotAdmitted"
                  ]
                },
                "registry": {
                  "type": "object",
                  "properties": {
                    "entry": {
                      "type": ["string", "null"]
                    },
                    "requirement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fixtureId": {
                      "type": "string",
                      "pattern": "^CE-FX-PROP-"
                    },
                    "descriptorOf": {
                      "enum": ["font-face"]
                    },
                    "unregisteredReason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false,
                  "required": ["entry"]
                },
                "flags": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "numeric-coercion",
                      "font-face-descriptor",
                      "vendor-prefixed",
                      "important-ignored",
                      "conditional-context-not-checked",
                      "pseudo-element-not-checked",
                      "raw-value-needs-token"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "property",
                "value",
                "context",
                "denominator",
                "registry"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": ["fixtureId", "path", "sha256", "counts", "declarations"]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "task",
    "generatedBy",
    "statement",
    "registryVersion",
    "totals",
    "stylesheets"
  ]
}
