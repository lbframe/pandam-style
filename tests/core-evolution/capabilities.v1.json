  "limitations": [
    {
      "id": "LIM-01",
      "kind": "architectural-exclusion",
      "title": "Unbounded runtime CSS values",
      "statement": "StyleX dynamic function styles and Panda runtime values need an inline custom-property or value channel. PandamStyle admits only finite authenticated selections; behavior that truly needs unrestricted runtime values is a product limitation, never approximated by bucketing and labeled equivalent.",
      "capabilities": ["CAP-36", "CAP-37", "CAP-45"],
      "evidence": "core-evolution-coverage.md Explicit architecture dispositions; core-evolution-upstreams.md StyleX dynamic values and Panda dynamic selection rows"
    },
    {
      "id": "LIM-02",
      "kind": "architectural-exclusion",
      "title": "Runtime style injection",
      "statement": "Runtime stylesheet injection, including development helpers, is excluded. Stylesheets and HMR must work under restrictive CSP; AG-13 owns removal of inherited display surfaces.",
      "capabilities": ["CAP-36", "CAP-44"],
      "evidence": "core-evolution-coverage.md; StyleX 0.19.1 unplugin devMode 'full' injects runtime and HTML in development"
    },
    {
      "id": "LIM-03",
      "kind": "architectural-exclusion",
      "title": "Arbitrary consumer selectors, tokens or policy overrides",
      "statement": "Replaced with declared project vocabulary. Upstream arbitrary-selector equivalence is not claimed; unauthorized selectors fail validation in every authoring context.",
      "capabilities": ["CAP-23", "CAP-24"],
      "evidence": "core-evolution-coverage.md Explicit architecture dispositions"
    },
    {
      "id": "LIM-04",
      "kind": "application-responsibility",
      "title": "Runtime DOM and native API behavior",
      "statement": "Opening dialogs, starting a native view transition or driving scroll position is application behavior. The styling contract, attributes and native API dependency are qualified together; CSS alone does not implement them.",
      "capabilities": ["CAP-39", "CAP-40"],
      "evidence": "core-evolution-coverage.md Explicit architecture dispositions"
    },
    {
      "id": "LIM-05",
      "kind": "unsupported-platform",
      "title": "Obsolete engines",
      "statement": "Internet Explorer, legacy EdgeHTML, Presto and KHTML are unsupported platforms. Their prefixed entries remain in the registry denominator as obsolete-engine-prefix dispositions; CE-01 records the incompatibility.",
      "capabilities": ["CAP-41"],
      "evidence": "Registry obsolete-engine-prefix entries; D-BP-05"
    },
    {
      "id": "LIM-06",
      "kind": "target-limited",
      "title": "Unshipped or partially shipped browser features",
      "statement": "A feature without stable support in a profile target is native-only progressive enhancement or needs an approved equivalent; it never receives a general support label. Required in-profile capabilities without an equivalent block that profile.",
      "capabilities": ["CAP-38", "CAP-39", "CAP-40"],
      "evidence": "BCD 8.1.6 statements in registry entries; D-BP-06"
    },
    {
      "id": "LIM-07",
      "kind": "unsupported-platform",
      "title": "Platform-scoped desktop and vendor extensions",
      "statement": "Electron and vendor extensions such as -webkit-app-region are scoped to their exact Chromium/Electron profile and are not portable browser CSS.",
      "capabilities": ["CAP-11"],
      "evidence": "Registry scoped-platform-extension entries; D-BP-03"
    },
    {
      "id": "LIM-08",
      "kind": "upstream-limitation-disclosed",
      "title": "Panda responsive variants with compound variants",
      "statement": "Panda 2.2.0 rejects responsive variant values on recipes with compound variants. PandamStyle must define and prove its finite condition-state semantics if the accepted corpus needs the combination; the upstream restriction is disclosed, not inherited silently.",
      "capabilities": ["CAP-32"],
      "evidence": "core-evolution-upstreams.md P7"
    },
    {
      "id": "LIM-09",
      "kind": "architectural-exclusion",
      "title": "Script-binding CSS properties",
      "statement": "behavior (IE HTML Components) and -moz-binding (XBL) attach script behavior through CSS. They are incompatible runtime requirements with no static equivalent.",
      "capabilities": ["CAP-01"],
      "evidence": "Registry incompatible-runtime-requirement entries"
    }
  ],
