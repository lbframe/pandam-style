{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/schema/task.schema.json",
  "title": "PandamStyle agentic evaluation task (pms-agentic-task/v1)",
  "description": "One evaluation task: inputs given to the evaluated agent, its permissions and environment, and per-epoch independent oracles executed by the harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "split",
    "workflow",
    "caseType",
    "tags",
    "workspace",
    "prompt",
    "permissions",
    "capabilities",
    "environment",
    "budget",
    "expectations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "heldout"
      ]
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "caseType": {
      "enum": [
        "positive",
        "failure",
        "boundary"
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+(:[a-z0-9.-]+)?$"
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture"
      ],
      "properties": {
        "fixture": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
          }
        },
        "uncommittedOverlay": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
        },
        "git": {
          "enum": [
            "baseline-commit",
            "none"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "prepare": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "prompt": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.md$"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writable",
        "protected",
        "allowDelete",
        "harnessIgnored"
      ],
      "properties": {
        "writable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
          }
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
          }
        },
        "allowDelete": {
          "type": "boolean"
        },
        "harnessIgnored": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "granted",
        "withheld"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace.read",
              "workspace.write",
              "shell.exec",
              "host.build",
              "host.dev-server",
              "design-system.edit",
              "package.install",
              "network.registry",
              "git.read",
              "git.write"
            ]
          }
        },
        "granted": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace.read",
              "workspace.write",
              "shell.exec",
              "host.build",
              "host.dev-server",
              "design-system.edit",
              "package.install",
              "network.registry",
              "git.read",
              "git.write"
            ]
          }
        },
        "withheld": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "workspace.read",
              "workspace.write",
              "shell.exec",
              "host.build",
              "host.dev-server",
              "design-system.edit",
              "package.install",
              "network.registry",
              "git.read",
              "git.write"
            ]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "host",
        "packageManager",
        "install",
        "pandamstyle",
        "network"
      ],
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "host": {
          "enum": [
            "vite",
            "rsbuild",
            "next-webpack",
            "next-turbopack",
            "webpack",
            "none"
          ]
        },
        "hostVersion": {
          "type": "string"
        },
        "packageManager": {
          "enum": [
            "npm",
            "yarn",
            "pnpm"
          ]
        },
        "install": {
          "enum": [
            "before-agent",
            "none"
          ]
        },
        "pandamstyle": {
          "enum": [
            "candidate-packages",
            "none"
          ]
        },
        "network": {
          "enum": [
            "none",
            "package-registry"
          ]
        },
        "browser": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pandamstyle-agent-docs"
            ]
          },
          "description": "Read-only agent resources the runner mounts outside the workspace. pandamstyle-agent-docs: docs/agent-*.md, docs/reference/ and benchmarks/alpha1-reference.json of the product revision under test."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutSeconds",
        "maxTurns"
      ],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "notes": {
      "type": "string"
    },
    "expectations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expectation"
      }
    }
  },
  "$defs": {
    "workflow": {
      "enum": [
        "discovery",
        "composition",
        "states",
        "themes",
        "slots",
        "variants",
        "repair",
        "design-system-extension",
        "audit",
        "installation",
        "migration",
        "measurement",
        "recovery",
        "concurrent-edits"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "roots",
        "outDir"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
          }
        },
        "outDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "after-tool-calls",
                "after-seconds",
                "after-file-write"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "glob": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
            }
          }
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "readyPattern"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "command": {
          "type": "string"
        },
        "readyPattern": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "intendedOutcome",
        "checks"
      ],
      "properties": {
        "classification": {
          "enum": [
            "expressible",
            "missing-product-capability",
            "missing-project-vocabulary"
          ]
        },
        "classificationRationale": {
          "type": "string",
          "minLength": 1
        },
        "intendedOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary"
          ],
          "properties": {
            "kind": {
              "enum": [
                "application-success",
                "integration-success",
                "read-only-report",
                "capability-gap-diagnosis",
                "vocabulary-gap-diagnosis",
                "clarification",
                "refusal",
                "conflict-diagnosis"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "class",
        "required",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "scope.diff",
            "scope.unchanged",
            "files.contains",
            "compile.project",
            "host.build",
            "generated.consistent",
            "definition.diff",
            "static.forbidden",
            "static.host-config",
            "static.package-json",
            "render.styles",
            "report.final",
            "transcript.commands",
            "observation.runner",
            "visual.fidelity"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scope.diff"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "scope.diff"
              },
              "class": {
                "enum": [
                  "scope"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expectChanges": {
                "enum": [
                  "none",
                  "some",
                  "any"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scope.unchanged"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "scope.unchanged"
              },
              "class": {
                "enum": [
                  "scope"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description",
              "paths"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "files.contains"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "files.contains"
              },
              "class": {
                "enum": [
                  "scope",
                  "static"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
              },
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "absent": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exists": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "compile.project"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "compile.project"
              },
              "class": {
                "enum": [
                  "compile"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expect": {
                "enum": [
                  "ok",
                  "fail"
                ]
              },
              "diagnosticCodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^PMS_[A-Z_]+$"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description",
              "expect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "host.build"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "host.build"
              },
              "class": {
                "enum": [
                  "compile"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "script": {
                "type": "string"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "generated.consistent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "generated.consistent"
              },
              "class": {
                "enum": [
                  "integrity"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "no-hand-edits",
                  "must-match"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description",
              "mode"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "definition.diff"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "definition.diff"
              },
              "class": {
                "enum": [
                  "integrity"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "added": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "changed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowExtraAdded": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "static.forbidden"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "static.forbidden"
              },
              "class": {
                "enum": [
                  "static"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
                }
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "jsx-style-prop",
                    "runtime-style-injection",
                    "css-in-js-import",
                    "stylesheet-import",
                    "raw-classname",
                    "type-escape",
                    "direct-pandamstyle-import",
                    "generated-internal-import"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description",
              "rules"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "static.host-config"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "static.host-config"
              },
              "class": {
                "enum": [
                  "static"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!\\./)(?!(.*/)?\\.\\.(/|$))[^\\s]+$"
              },
              "module": {
                "enum": [
                  "@pandamstyle/vite",
                  "@pandamstyle/rsbuild",
                  "@pandamstyle/next"
                ]
              },
              "expect": {
                "type": "object"
              },
              "forbidOptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "preservePlugins": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "class",
              "required",
              "description",
              "file",
              "module",
              "expect"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "static.package-json"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "kind": {
                "const": "static.package-json"
              },
              "class": {
                "enum": [
                  "static"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "file": {
