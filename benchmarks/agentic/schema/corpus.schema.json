{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/schema/corpus.schema.json",
  "title": "Agentic corpus descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusVersion",
    "referenceEpoch",
    "epochs",
    "workflows",
    "caseTypes",
    "requiredTags",
    "splits",
    "freeze"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "corpusVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "referenceEpoch": {
      "type": "string"
    },
    "epochs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "product",
          "status"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "commits"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "commits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$"
                }
              },
              "note": {
                "type": "string"
              }
            }
          },
          "status": {
            "enum": [
              "reference",
              "planned",
              "superseded"
            ]
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "caseTypes": {
      "type": "array",
      "items": {
        "enum": [
          "positive",
          "failure",
          "boundary"
        ]
      }
    },
    "requiredTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development",
        "heldout"
      ],
      "properties": {
        "development": {
          "type": "string"
        },
        "heldout": {
          "type": "string"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholdsFrozen"
      ],
      "properties": {
        "thresholdsFrozen": {
          "type": "boolean",
          "description": "Set to true by AG-00.3 when baseline thresholds are frozen; from then on the held-out set may only be unsealed for AG-12.2 or seal verification."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
