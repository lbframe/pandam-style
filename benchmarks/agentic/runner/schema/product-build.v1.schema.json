{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/runner/schema/product-build.v1.schema.json",
  "title": "Product build binding (pms-agentic-product-build/v1)",
  "description": "Binds runs to a PandamStyle product build by artifact digests (runner/DESIGN.md section 4.8). Binds only the product tarballs, the Node runtime and the source archive (agent docs); never the CE closure or npm cache. Artifacts are read from a verified copy of the store, never from the original. Candidate packing from a commit is future work and not accepted by this draft (F1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch",
    "source",
    "packages",
    "node",
    "agentDocs",
    "provenance",
    "storeCopy",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "pms-agentic-product-build/v1"
    },
    "epoch": {
      "type": "string",
      "description": "An epoch of corpus.json whose product.commits contains source.commit."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "archiveFile",
        "archiveSha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archiveFile": {
          "type": "string"
        },
        "archiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "file",
          "sha256",
          "integrity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@pandamstyle/[a-z0-9-]+$"
          },
          "version": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "Path relative to the verified store copy."
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha512-"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "file",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "agentDocs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "paths",
        "treeDigest"
      ],
      "properties": {
        "from": {
          "const": "source-archive"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "treeDigest": {
          "type": "string",
          "description": "pms-tree-sha256/v1 digest of the extracted documentation tree."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifestSha256",
        "manifestSource"
      ],
      "properties": {
        "kind": {
          "const": "ce-baseline-manifest"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSource": {
          "type": "string",
          "description": "Git ref and path the manifest was read from, e.g. main@e2a864b:benchmarks/core-evolution/epochs/alpha1/manifest.v1.json."
        }
      }
    },
    "storeCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "verifiedArtifacts",
        "archiveVerify"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Verified copy of the store, home directory written as ~. Never the original store."
        },
        "verifiedArtifacts": {
          "type": "array",
          "description": "Every artifact the runner consumes, with the sha256 it recomputed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "archiveVerify": {
          "type": [
            "object",
            "null"
          ],
          "description": "Result of tools/baselines/archive.mjs verify on the store copy when run; null otherwise."
        }
      }
    },
    "digest": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the canonical JSON of this object without the digest field."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
