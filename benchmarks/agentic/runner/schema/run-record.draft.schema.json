{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/runner/schema/run-record.draft.schema.json",
  "title": "DRAFT attempt record (pms-agentic-run-record/v0-draft)",
  "description": "DRAFT for the AG-00.2 design review; not a stable contract. One attempt of one repetition of one task x model cell (runner/DESIGN.md). Missing or ambiguous telemetry is status unknown with value null, never 0; a value is observed only with harness or cli-attested integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "matrixId",
    "cell",
    "repetition",
    "attempt",
    "comparability",
    "task",
    "harness",
    "prompt",
    "modelConfig",
    "cli",
    "provider",
    "budgets",
    "productBuild",
    "trustedTree",
    "environment",
    "integrity",
    "timestamps",
    "outcome",
    "grading",
    "metrics",
    "credential",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "pms-agentic-run-record/v0-draft" },
    "kind": { "enum": ["provider-backed", "adapter-fixture"] },
    "matrixId": { "type": "string", "minLength": 1 },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "modelKey"],
      "properties": {
        "taskId": { "type": "string" },
        "modelKey": { "type": "string" }
      }
    },
    "repetition": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "projectionVersion", "projection"],
      "properties": {
        "key": { "$ref": "#/$defs/sha256" },
        "projectionVersion": { "const": "pms-agentic-comparability/v1" },
        "projection": {
          "type": "object",
          "description": "The exact normalized projection hashed into key (DESIGN.md section 1.4).",
          "additionalProperties": false,
          "required": ["task", "harness", "prompt", "model", "policy", "budgets", "containers", "dependencies"],
          "properties": {
            "task": { "type": "object" },
            "harness": { "type": "object" },
            "prompt": { "type": "object" },
            "model": { "type": "object" },
            "policy": { "type": "object" },
            "budgets": { "type": "object" },
            "containers": { "type": "object" },
            "dependencies": { "type": "object" }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "workflow", "caseType", "epoch", "corpusVersion", "corpusLockSha256", "taskDigest"],
      "properties": {
        "id": { "type": "string" },
        "split": { "const": "development" },
        "workflow": { "type": "string" },
        "caseType": { "type": "string" },
        "epoch": { "type": "string" },
        "corpusVersion": { "type": "string" },
        "corpusLockSha256": { "$ref": "#/$defs/sha256" },
        "taskDigest": { "type": "string" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "clean", "corpusLockSha256", "runnerTreeDigest", "harnessDepsLockSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "clean": { "type": "boolean" },
        "corpusLockSha256": { "$ref": "#/$defs/sha256" },
        "runnerTreeDigest": { "type": "string" },
        "harnessDepsLockSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "docsPath", "channel"],
      "properties": {
        "file": { "const": "prompt.md" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "docsPath": { "type": "string" },
        "channel": { "enum": ["argv", "stdin"] }
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedModel", "reasoningEffort", "rawArgv", "normalizedArgv", "env", "configFiles", "effectiveConfig"],
      "properties": {
        "requestedModel": { "type": "string" },
        "reasoningEffort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "effective"],
          "properties": {
            "requested": { "type": "string" },
            "effective": { "type": ["string", "null"], "description": "null when the CLI does not report it." }
          }
        },
        "rawArgv": { "type": "array", "items": { "type": "string" } },
        "normalizedArgv": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "description": "Variable names passed to the CLI; values only for non-secret variables, otherwise <secret>.",
          "additionalProperties": { "type": "string" }
        },
        "configFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "normalizedSha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "normalizedSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "effectiveConfig": {
          "type": "object",
          "description": "Evidence of the configuration in force (DESIGN.md section 3.3): Claude init fields; Codex debug prompt-input digest and accepted strict config.",
          "additionalProperties": false,
          "required": ["source", "tools", "subagents", "web", "matchesRequest"],
          "properties": {
            "source": { "type": "string" },
            "tools": { "type": ["array", "null"], "items": { "type": "string" } },
            "subagents": { "enum": ["disabled-evidenced", "disabled-configured", "enabled", "unknown"] },
            "web": { "enum": ["disabled-evidenced", "disabled-configured", "enabled", "unknown"] },
            "builtins": { "type": "array", "items": { "type": "string" } },
            "matchesRequest": { "type": "boolean" }
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "executeOnly"],
      "properties": {
        "name": { "enum": ["claude", "codex"] },
        "version": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "executeOnly": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "primaryModelFidelity", "auxiliaryModels"],
      "properties": {
        "sessionId": { "type": ["string", "null"] },
        "primaryModelFidelity": {
          "enum": ["faithful", "violated", "no-reroute-surfaced", "unknown"],
          "description": "Claude: init.model and every main-loop message.model equal the request and no fallback event. Codex: served model unknown; only surfaced reroutes are detectable."
        },
        "servedModels": {
          "description": "Main-loop served model ids, or unknown when the CLI does not report them.",
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "const": "unknown" }
          ]
        },
        "auxiliaryModels": { "type": "array", "items": { "type": "string" } },
        "reroutes": { "type": "array", "items": { "type": "string" } },
        "apiRetries": { "type": ["integer", "null"] },
        "rateLimit": { "type": ["object", "null"] }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusTimeoutSeconds", "corpusMaxTurnsHint", "timeoutSeconds", "maxToolCalls", "cliMaxTurns", "limitFired"],
      "properties": {
        "corpusTimeoutSeconds": { "type": "integer" },
        "corpusMaxTurnsHint": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "maxToolCalls": { "type": "integer" },
        "cliMaxTurns": { "type": ["integer", "null"] },
        "limitFired": { "enum": [null, "timeout", "max-tool-calls", "cli-max-turns", "memory", "pids", "workspace-size"] }
      }
    },
    "productBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "epoch", "sourceCommit"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "epoch": { "type": "string" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "trustedTree": {
      "type": "object",
      "description": "The node_modules tree used by grading (--trusted-node-modules), built only from the verified fixture closure with the product tarballs; checked before each grading pass.",
      "additionalProperties": false,
      "required": ["digest", "pandamstyleDigest", "matchesProductTarballs", "checkedBeforeGrading"],
      "properties": {
        "digest": { "type": "string" },
        "pandamstyleDigest": { "type": "string" },
        "matchesProductTarballs": { "const": true },
        "checkedBeforeGrading": { "const": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "dockerVersion", "kernel", "cpuModel", "cpus", "memoryBytes", "load", "cgroup", "isolationSelfTest"],
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent", "grader", "proxy"],
          "properties": {
            "agent": { "type": "string" },
            "grader": { "type": "string" },
            "proxy": { "type": "string" }
          }
        },
        "dockerVersion": { "type": "string" },
        "kernel": { "type": "string" },
        "cpuModel": { "type": "string" },
        "cpus": { "type": "integer" },
        "memoryBytes": { "type": "integer" },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": ["samples", "min", "max", "median"],
          "properties": {
            "samples": { "type": "integer" },
            "min": { "type": ["number", "null"] },
            "max": { "type": ["number", "null"] },
            "median": { "type": ["number", "null"] }
          }
        },
        "cgroup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuUsageUsec", "memoryPeakBytes", "pidsPeak"],
          "properties": {
            "cpuUsageUsec": { "$ref": "#/$defs/measured" },
            "memoryPeakBytes": { "$ref": "#/$defs/measured" },
            "pidsPeak": { "$ref": "#/$defs/measured" }
          }
        },
        "isolationSelfTest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "bindingDigest", "passedAt"],
          "properties": {
            "id": { "type": "string" },
            "bindingDigest": { "$ref": "#/$defs/sha256" },
            "passedAt": { "type": "string" }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "channelAudit", "anomalies", "contested"],
      "properties": {
        "stream": { "enum": ["cli-attested", "cli-unattested"] },
        "channelAudit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["samples", "cliNonDumpable", "foreignStreamHolders", "controlSocketConnections"],
          "properties": {
            "samples": { "type": "integer", "minimum": 0 },
            "cliNonDumpable": { "type": ["boolean", "null"] },
            "foreignStreamHolders": { "type": "integer", "minimum": 0 },
            "controlSocketConnections": { "type": "integer", "minimum": 0 }
          }
        },
        "anomalies": { "type": "array", "items": { "type": "string" } },
        "contested": { "type": "boolean" }
      }
    },
    "timestamps": {
      "type": "object",
      "description": "Per phase: startedAt/endedAt (UTC ISO 8601) and monotonic durationMs.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startedAt", "endedAt", "durationMs"],
        "properties": {
          "startedAt": { "type": "string" },
          "endedAt": { "type": ["string", "null"] },
          "durationMs": { "type": ["number", "null"] }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termination", "class", "code", "valid", "retry", "taskSuccess"],
      "properties": {
        "termination": {
          "enum": ["completed", "budget-timeout", "budget-max-tool-calls", "cli-max-turns", "context-exhausted", "resource-limit", "abnormal-exit", "policy", "infrastructure", "unclassified", "harness"]
        },
        "class": { "enum": ["agent", "agent-resource", "agent-abnormal", "policy", "infrastructure", "unclassified", "harness"] },
        "code": { "type": "string" },
        "valid": {
          "type": "boolean",
          "description": "False for infrastructure, unclassified and harness classes: excluded from success statistics, still reported."
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheduled"],
          "properties": {
            "scheduled": { "type": "boolean" },
            "backoffSeconds": { "type": ["number", "null"] }
          }
        },
        "taskSuccess": {
          "type": ["boolean", "null"],
          "description": "Grading verdict pass and termination completed within budget; null when not graded."
        },
        "breaches": {
          "type": "array",
          "description": "Policy and scope breaches observed whatever the verdict.",
          "items": {
            "type": "object",
            "required": ["kind", "source", "enforcement"],
            "properties": {
              "kind": { "type": "string" },
              "source": { "enum": ["oracle", "proxy", "stream", "transcript", "filesystem", "channel-audit", "redaction"] },
              "enforcement": { "enum": ["prevented", "detected"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "passes"],
      "properties": {
        "verdict": {
          "enum": ["pass", "fail", "unmeasured", "error", "not-evaluable", "not-graded"],
          "description": "Final grading verdict (G2 verdict when consistent with G1; never pass if G2 aborted or disagreed)."
        },
        "passes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pass", "status", "verdict"],
            "properties": {
              "pass": { "enum": ["G1", "G2"] },
              "status": { "enum": ["completed", "aborted-by-agent-code", "inconsistent", "harness-error", "not-run"] },
              "verdict": { "type": ["string", "null"] },
              "resultSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCalls", "agentSteps", "repairCycles", "firstPassSuccess", "coverage", "tokens", "cost", "elapsed", "toolCost", "compilerCost", "visualFidelity", "vocabularyCompliance", "scopeViolations"],
      "properties": {
        "toolCalls": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/measured" }
        },
        "agentSteps": { "$ref": "#/$defs/measured" },
        "repairCycles": { "$ref": "#/$defs/measured" },
        "firstPassSuccess": { "enum": [true, false, "unknown"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "reasons"],
          "properties": {
            "complete": { "type": "boolean" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "normalized"],
          "properties": {
            "raw": {
              "type": "object",
              "description": "Counters exactly as the CLI printed them, with their source path."
            },
            "normalized": {
              "type": "object",
              "description": "Per served model and total: inputUncached, inputCacheRead, inputCacheWrite, inputTotal, outputTotal, outputReasoning (subset of outputTotal).",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/measured" }
              }
            }
          }
        },
        "cost": { "$ref": "#/$defs/measured" },
        "elapsed": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/measured" }
        },
        "toolCost": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/measured" }
        },
        "compilerCost": {
          "type": "object",
          "description": "Agent-invoked compiler/host builds and harness-side compile work, kept apart.",
          "additionalProperties": { "$ref": "#/$defs/measured" }
        },
        "visualFidelity": { "enum": ["pass", "fail", "unmeasured"] },
        "vocabularyCompliance": { "enum": ["pass", "fail", "unmeasured", "not-graded"] },
        "scopeViolations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realized", "prevented", "detected"],
          "properties": {
            "realized": { "type": "array", "items": { "type": "string" } },
            "prevented": { "type": "array", "items": { "type": "string" } },
            "detected": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "export"],
      "properties": {
        "mode": { "enum": ["access-only", "refresh-capable-copy", "none"] },
        "export": {
          "enum": ["not-applicable", "unchanged", "host-replaced", "conflict-not-written", "failed"],
          "description": "Outcome of the export phase before tmpfs destruction (DESIGN.md section 4.6). Never contains secret material."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "artifacts"],
      "properties": {
        "completeness": {
          "enum": ["complete", "redacted", "incomplete"],
          "description": "Re-grading is exact only when complete."
        },
        "affectedPaths": { "type": "array", "items": { "type": "string" } },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256", "bytes", "truncated", "redacted"],
            "properties": {
              "file": { "type": "string" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" },
              "originalBytes": { "type": ["integer", "null"] },
              "redacted": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "source", "integrity"],
      "properties": {
        "status": { "enum": ["observed", "estimate", "unknown"] },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "source": { "type": ["string", "null"] },
        "integrity": { "enum": ["harness", "cli-attested", "cli-unattested", null] },
        "method": { "type": ["string", "null"] },
        "lowerBound": { "type": ["number", "null"] },
        "discrepancy": { "type": ["object", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
          "then": { "properties": { "value": { "const": null } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["observed", "estimate"] } }, "required": ["status"] },
          "then": { "properties": { "value": { "type": "number" } } }
        },
        {
          "if": { "properties": { "status": { "const": "estimate" } }, "required": ["status"] },
          "then": { "required": ["method"], "properties": { "method": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "observed" } }, "required": ["status"] },
          "then": { "properties": { "integrity": { "enum": ["harness", "cli-attested"] } } }
        }
      ]
    }
  }
}
