{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/runner/schema/product-build.draft.schema.json",
  "title": "DRAFT product build binding (pms-agentic-product-build/v0-draft)",
  "description": "DRAFT for the AG-00.2 design review; not a stable contract. Binds runs to a PandamStyle product build by artifact digests (runner/DESIGN.md section 4.6). The runner verifies every digest itself before use and never writes to the store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch",
    "source",
    "packages",
    "node",
    "agentDocs",
    "provenance",
    "digest"
  ],
  "properties": {
    "schema": { "const": "pms-agentic-product-build/v0-draft" },
    "epoch": {
      "type": "string",
      "description": "An epoch of corpus.json whose product.commits contains source.commit."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "archiveSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "file", "sha256", "integrity"],
        "properties": {
          "name": { "type": "string", "pattern": "^@pandamstyle/[a-z0-9-]+$" },
          "version": { "type": "string" },
          "file": {
            "type": "string",
            "description": "Path relative to the store."
          },
          "sha256": { "$ref": "#/$defs/sha256" },
          "integrity": { "type": "string", "pattern": "^sha512-" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "file", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "file": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "agentDocs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "paths", "treeDigest"],
      "properties": {
        "from": { "const": "source-archive" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "treeDigest": {
          "type": "string",
          "description": "pms-tree-sha256/v1 digest of the extracted documentation tree."
        }
      }
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "manifestSha256", "manifestSource", "store"],
          "properties": {
            "kind": { "const": "ce-baseline-manifest" },
            "manifestSha256": { "$ref": "#/$defs/sha256" },
            "manifestSource": {
              "type": "string",
              "description": "Where the manifest file was read from, e.g. a git ref and path."
            },
            "store": {
              "type": "string",
              "description": "Store path with the home directory written as ~."
            },
            "archiveVerify": {
              "type": ["object", "null"],
              "description": "Result of tools/baselines/archive.mjs verify --replay when that tool is available; null otherwise."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "commit"],
          "properties": {
            "kind": { "const": "packed-from-commit" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "command": { "type": "string" }
          }
        }
      ]
    },
    "digest": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the canonical JSON of this object without the digest field."
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
