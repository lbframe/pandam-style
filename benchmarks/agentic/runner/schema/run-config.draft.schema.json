{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/runner/schema/run-config.draft.schema.json",
  "title": "DRAFT evaluation matrix configuration (pms-agentic-matrix/v0-draft)",
  "description": "DRAFT for the AG-00.2 design review; not a stable contract. The resolved matrix.json of runner/DESIGN.md. Tasks never name models; this file does. Held-out tasks are refused unconditionally in AG-00.2 (F1); no purpose value unlocks them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "purpose",
    "epoch",
    "tasks",
    "models",
    "repetitions",
    "maxAttempts",
    "productBuild",
    "images",
    "container",
    "network",
    "budgets",
    "credentials",
    "schedule"
  ],
  "properties": {
    "schema": { "const": "pms-agentic-matrix/v0-draft" },
    "kind": { "enum": ["provider-backed", "adapter-fixture"] },
    "purpose": { "enum": ["development", "smoke", "reference"] },
    "epoch": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modelConfig" }
    },
    "repetitions": { "type": "integer", "minimum": 1 },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Attempts per repetition; only infrastructure failures start a new attempt."
    },
    "productBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "manifestSha256"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "grader", "proxy", "baseDigest"],
      "properties": {
        "agent": { "$ref": "#/$defs/imageId" },
        "grader": { "$ref": "#/$defs/imageId" },
        "proxy": { "$ref": "#/$defs/imageId" },
        "baseDigest": { "$ref": "#/$defs/imageId" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "memoryBytes", "pidsLimit", "tmpfsBytes", "workspaceBytesCap"],
      "properties": {
        "cpus": { "type": "number", "minimum": 0 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "pidsLimit": { "type": "integer", "minimum": 1 },
        "tmpfsBytes": { "type": "integer", "minimum": 1 },
        "workspaceBytesCap": { "type": "integer", "minimum": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ipv6", "allow"],
      "properties": {
        "mode": {
          "const": "per-attempt-internal-isolated-gateway",
          "description": "Per-attempt --internal network with com.docker.network.bridge.gateway_mode_ipv4=isolated and a per-attempt CONNECT proxy."
        },
        "ipv6": { "const": false },
        "allow": {
          "type": "object",
          "description": "Per CLI, the host:port pairs the CONNECT proxy allows.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+:[0-9]+$" }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxToolCalls", "cliMaxTurns"],
      "properties": {
        "maxToolCalls": {
          "type": "string",
          "description": "'corpus-maxTurns-hint' or an integer as a string; the harness cap on normalized tool calls, recorded separately from the corpus hint."
        },
        "cliMaxTurns": {
          "type": "string",
          "description": "Claude --max-turns backstop (API round-trips), e.g. '2x-maxToolCalls'. Not equivalent to maxToolCalls."
        }
      }
    },
    "credentials": {
      "type": "object",
      "description": "Per provider: mode only, never a secret. access-only = no refresh token enters a container; refresh-capable-copy = full copy with export and compare-and-swap (forces concurrency 1 for that provider).",
      "additionalProperties": {
        "enum": ["access-only", "refresh-capable-copy", "none"]
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "concurrencyPerProvider", "timeWindows", "wallClockCapSeconds"],
      "properties": {
        "order": { "enum": ["sequential", "interleaved"] },
        "concurrencyPerProvider": { "type": "integer", "minimum": 1 },
        "timeWindows": {
          "type": "array",
          "description": "Operator time windows in which attempts may start (Q8); empty means unrestricted.",
          "items": { "type": "string" }
        },
        "wallClockCapSeconds": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "cli", "cliVersion", "cliSha256", "model", "reasoningEffort", "toolPolicy"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*$" },
        "cli": { "enum": ["claude", "codex"] },
        "cliVersion": { "type": "string" },
        "cliSha256": { "$ref": "#/$defs/sha256" },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": {
          "type": "string",
          "description": "Explicit value passed in argv (Q3); never left to a CLI default."
        },
        "toolPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "subagents"],
          "properties": {
            "web": { "const": false },
            "subagents": { "const": false }
          }
        }
      }
    }
  }
}
