{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lbframe/pandam-style/benchmarks/agentic/runner/schema/run-config.draft.schema.json",
  "title": "DRAFT evaluation matrix configuration (pms-agentic-matrix/v0-draft)",
  "description": "DRAFT for the AG-00.2 design review; not a stable contract. The resolved matrix.json of runner/DESIGN.md section 1. Tasks never name models; this file does.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "purpose",
    "epoch",
    "tasks",
    "models",
    "repetitions",
    "maxAttempts",
    "productBuild",
    "image",
    "container",
    "egress",
    "credentialMethod",
    "schedule"
  ],
  "properties": {
    "schema": { "const": "pms-agentic-matrix/v0-draft" },
    "kind": { "enum": ["provider-backed", "adapter-fixture"] },
    "purpose": {
      "enum": ["development", "smoke", "reference", "ag-12.2-final-qualification"],
      "description": "Held-out tasks are refused unless purpose is ag-12.2-final-qualification and PMS_HELDOUT_PURPOSE agrees."
    },
    "epoch": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modelConfig" }
    },
    "repetitions": { "type": "integer", "minimum": 1 },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "description": "Attempts per repetition; only infrastructure failures start a new attempt."
    },
    "productBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "manifestSha256"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baseDigest"],
      "properties": {
        "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "baseDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "memoryBytes", "pidsLimit", "tmpfsBytes", "workspaceBytesCap"],
      "properties": {
        "cpus": { "type": "number", "minimum": 0 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "pidsLimit": { "type": "integer", "minimum": 1 },
        "tmpfsBytes": { "type": "integer", "minimum": 1 },
        "workspaceBytesCap": { "type": "integer", "minimum": 1 }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "object",
          "description": "Per CLI, the host:port pairs the CONNECT proxy allows.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+:[0-9]+$" }
          }
        }
      }
    },
    "credentialMethod": {
      "type": "object",
      "description": "Method only; never a secret or a secret's location inside a home configuration directory.",
      "additionalProperties": {
        "enum": ["dedicated-token", "dedicated-login-copy", "existing-login-copy", "none"]
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "concurrencyPerProvider"],
      "properties": {
        "order": { "enum": ["sequential", "interleaved"] },
        "concurrencyPerProvider": { "type": "integer", "minimum": 1 },
        "wallClockCapSeconds": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "cli", "cliVersion", "cliSha256", "model", "reasoningEffort", "tools"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*$" },
        "cli": { "enum": ["claude", "codex"] },
        "cliVersion": { "type": "string" },
        "cliSha256": { "$ref": "#/$defs/sha256" },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": {
          "type": "string",
          "description": "Explicit value passed to the CLI; never left to a CLI default."
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "subagents"],
          "properties": {
            "web": { "type": "boolean" },
            "subagents": { "type": "boolean" }
          }
        }
      }
    }
  }
}
