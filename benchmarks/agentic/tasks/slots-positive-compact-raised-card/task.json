{
  "schemaVersion": 1,
  "id": "slots-positive-compact-raised-card",
  "title": "Compact raised product card with a second footer action",
  "split": "development",
  "workflow": "slots",
  "caseType": "positive",
  "tags": [
    "host:vite",
    "project-shape:vite-react-storefront"
  ],
  "workspace": {
    "fixture": "vite-react-storefront",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/components/ProductCard.jsx"
    ],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "Slot recipe selection with a compound variant and an additional recipe button in the footer slot."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "card-root",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/ProductCard.jsx",
            "export": "ProductCard",
            "props": {
              "product": {
                "id": "p1",
                "name": "Canvas tote",
                "description": "Sturdy.",
                "inStock": true
              }
            }
          },
          "select": {
            "testId": "product-card-p1"
          },
          "expect": {
            "styles": {
              "box-shadow": {
                "token": "shadows.raised"
              },
              "border-radius": {
                "token": "radii.sm"
              },
              "border-style": {
                "absent": true
              }
            }
          },
          "description": "Raised + compact compound radius on the root slot."
        },
        {
          "id": "card-header",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/ProductCard.jsx",
            "export": "ProductCard",
            "props": {
              "product": {
                "id": "p1",
                "name": "Canvas tote",
                "description": "Sturdy.",
                "inStock": true
              }
            }
          },
          "select": {
            "tag": "header",
            "within": {
              "testId": "product-card-p1"
            }
          },
          "expect": {
            "styles": {
              "padding": {
                "token": "spacing.sm"
              }
            }
          },
          "description": "Compact header padding."
        },
        {
          "id": "save-button",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/ProductCard.jsx",
            "export": "ProductCard",
            "props": {
              "product": {
                "id": "p1",
                "name": "Canvas tote",
                "description": "Sturdy.",
                "inStock": true
              }
            }
          },
          "select": {
            "testId": "save-for-later"
          },
          "expect": {
            "styles": {
              "background-color": {
                "token": "colors.surface.raised"
              },
              "font-size": {
                "token": "fontSizes.sm"
              }
            }
          },
          "description": "Small neutral button."
        },
        {
          "id": "footer-order",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/ProductCard.jsx",
            "export": "ProductCard",
            "props": {
              "product": {
                "id": "p1",
                "name": "Canvas tote",
                "description": "Sturdy.",
                "inStock": true
              }
            }
          },
          "select": {
            "tag": "button",
            "within": {
              "testId": "product-footer"
            }
          },
          "expect": {
            "count": 2,
            "attributes": {
              "data-testid": "save-for-later"
            }
          },
          "description": "Save for later precedes Add to cart.",
          "index": 0
        }
      ]
    }
  }
}
