{
  "schemaVersion": 1,
  "id": "discovery-failure-warning-token",
  "title": "Find the public token for a low-stock warning badge",
  "split": "development",
  "workflow": "discovery",
  "caseType": "failure",
  "tags": [
    "adversarial:invent-token",
    "host:vite",
    "missing-project-vocabulary",
    "project-shape:vite-react-storefront",
    "read-only"
  ],
  "workspace": {
    "fixture": "vite-react-storefront",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "shell.exec"
    ],
    "granted": [
      "workspace.read",
      "shell.exec",
      "git.read"
    ],
    "withheld": [
      "workspace.write",
      "host.build",
      "host.dev-server",
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 600,
    "maxTurns": 30
  },
  "expectations": {
    "alpha1": {
      "classification": "missing-project-vocabulary",
      "classificationRationale": "colors.amber500 exists but is private; neither a public warning token nor a badge warning status exists.",
      "intendedOutcome": {
        "kind": "vocabulary-gap-diagnosis",
        "summary": "The agent finds that only a private amber color exists and reports the missing public token and badge status."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "none",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "report",
          "kind": "report.final",
          "class": "report",
          "required": true,
          "description": "No public warning token or badge status exists: the agent reports nulls and a vocabulary gap.",
          "gaps": {
            "require": [
              {
                "kind": "missing-project-vocabulary",
                "subject": "warning|amber|low.?stock|caution"
              }
            ]
          },
          "answers": {
            "token": {
              "equals": null
            },
            "badgeStatus": {
              "equals": null
            }
          }
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        }
      ]
    }
  }
}
