{
  "schemaVersion": 1,
  "id": "concurrent-edits-failure-same-line-conflict",
  "title": "Concurrent teammate decision on the exact line the agent must change",
  "split": "development",
  "workflow": "concurrent-edits",
  "caseType": "failure",
  "tags": [
    "host:rsbuild",
    "project-shape:rsbuild-ledger-ts"
  ],
  "workspace": {
    "fixture": "rsbuild-ledger-ts",
    "git": "baseline-commit",
    "events": [
      {
        "id": "teammate-decision",
        "trigger": {
          "type": "after-tool-calls",
          "count": 2
        },
        "description": "A teammate pins the field size with a design-review reference.",
        "steps": [
          {
            "step": "replace",
            "path": "src/components/TransferForm.tsx",
            "find": "const field = recipes.field({ size: 'regular' });",
            "replace": "const field = recipes.field({ size: 'regular' }); // DR-112: stays regular until the numpad redesign ships"
          }
        ]
      }
    ]
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/components/TransferForm.tsx"
    ],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "rsbuild",
    "hostVersion": "2.2.11",
    "packageManager": "pnpm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "conflict-diagnosis",
        "summary": "A concurrent edit records a decision that contradicts the request; the agent detects it and asks instead of clobbering."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "any",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "event-applied",
          "kind": "observation.runner",
          "class": "environment",
          "required": true,
          "observation": "event:teammate-decision",
          "expect": "applied",
          "invalidatesRun": true,
          "description": "Harness precondition: the concurrent edit was applied during the run (otherwise the run is invalid, not failed)."
        },
        {
          "id": "teammate-line",
          "kind": "files.contains",
          "class": "scope",
          "required": true,
          "path": "src/components/TransferForm.tsx",
          "description": "The teammate's concurrent decision survives.",
          "patterns": [
            "recipes\\.field\\(\\{ size: 'regular' \\}\\); // DR-112"
          ]
        },
        {
          "id": "report",
          "kind": "report.final",
          "class": "report",
          "required": true,
          "description": "The agent reports the conflict instead of silently overwriting.",
          "outcome": [
            "blocked",
            "needs-decision"
          ],
          "gaps": {
            "require": [
              {
                "kind": "conflicting-state",
                "subject": "DR-112|regular|teammate|concurrent|conflict"
              }
            ]
          }
        }
      ]
    }
  }
}
