{
  "schemaVersion": 1,
  "id": "measurement-positive-quick-estimate",
  "title": "Quick benchmark estimate without executing workloads",
  "split": "development",
  "workflow": "measurement",
  "caseType": "positive",
  "tags": [
    "host:vite",
    "project-shape:vite-react-storefront",
    "read-only"
  ],
  "workspace": {
    "fixture": "vite-react-storefront",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "shell.exec"
    ],
    "granted": [
      "workspace.read",
      "shell.exec",
      "git.read"
    ],
    "withheld": [
      "workspace.write",
      "host.build",
      "host.dev-server",
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 600,
    "maxTurns": 30
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "read-only-report",
        "summary": "A labelled estimate citing reference cells, with measured=false and no executed workload."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "none",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "report",
          "kind": "report.final",
          "class": "report",
          "required": true,
          "description": "Quick-estimate shape, explicitly not measured.",
          "answers": {
            "mode": {
              "equals": "quick-estimate"
            },
            "measured": {
              "equals": false
            },
            "statement": {
              "matches": "no workload was executed",
              "caseInsensitive": true
            },
            "estimate.workloadFit": {
              "oneOf": [
                "smaller",
                "unknown"
              ]
            },
            "confidence": {
              "oneOf": [
                "low",
                "medium"
              ]
            }
          }
        },
        {
          "id": "commands",
          "kind": "transcript.commands",
          "class": "transcript",
          "required": true,
          "forbid": [
            "\\b(npm|yarn|pnpm)\\s+(run\\s+)?(build|dev|install|i|add|ci)\\b",
            "\\bvite(\\s+build)?\\b",
            "\\bnode\\s+.*benchmark"
          ],
          "description": "No build, dev, install or workload command ran."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        }
      ]
    }
  }
}
