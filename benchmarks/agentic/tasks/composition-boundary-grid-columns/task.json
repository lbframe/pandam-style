{
  "schemaVersion": 1,
  "id": "composition-boundary-grid-columns",
  "title": "Responsive grid at the edges of the column domain",
  "split": "development",
  "workflow": "composition",
  "caseType": "boundary",
  "tags": [
    "host:next-webpack",
    "project-shape:next-webpack-console"
  ],
  "workspace": {
    "fixture": "next-webpack-console",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "app/page.jsx"
    ],
    "protected": [
      "design.pandamstyle.config.mjs",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      ".next/**",
      ".pandamstyle-next-host/**",
      "next-env.d.ts"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "next-webpack",
    "hostVersion": "16.3.8",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "classificationRationale": "patterns.grid admits integer columns 1..6 with responsive maps over declared conditions.",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "The grid pattern expresses 2 and 6 columns through base and the declared desktop condition."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "grid-desktop",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "app/page.jsx"
          },
          "select": {
            "testId": "service-grid"
          },
          "expect": {
            "styles": {
              "grid-template-columns": {
                "value": "repeat(6, minmax(0, 1fr))"
              },
              "gap": {
                "token": "spacing.base"
              }
            }
          },
          "description": "Six columns at the maximum of the finite domain.",
          "context": {
            "viewportWidth": 1280
          }
        },
        {
          "id": "grid-breakpoint",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "app/page.jsx"
          },
          "select": {
            "testId": "service-grid"
          },
          "expect": {
            "styles": {
              "grid-template-columns": {
                "value": "repeat(6, minmax(0, 1fr))"
              }
            }
          },
          "description": "The declared desktop condition is min-width 1024px inclusive.",
          "context": {
            "viewportWidth": 1024
          }
        },
        {
          "id": "grid-small",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "app/page.jsx"
          },
          "select": {
            "testId": "service-grid"
          },
          "expect": {
            "styles": {
              "grid-template-columns": {
                "value": "repeat(2, minmax(0, 1fr))"
              }
            }
          },
          "description": "Two columns below the breakpoint.",
          "context": {
            "viewportWidth": 1023
          }
        }
      ]
    }
  }
}
