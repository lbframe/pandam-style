{
  "schemaVersion": 1,
  "id": "design-system-extension-boundary-theme-aware-token",
  "title": "Authorized token that must resolve correctly across inheriting themes",
  "split": "development",
  "workflow": "design-system-extension",
  "caseType": "boundary",
  "tags": [
    "host:rsbuild",
    "missing-project-vocabulary",
    "project-shape:rsbuild-ledger-ts"
  ],
  "workspace": {
    "fixture": "rsbuild-ledger-ts",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "design.pandamstyle.config.js",
      "src/components/TransferForm.tsx"
    ],
    "protected": [
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "design-system.edit"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "design-system.edit",
      "git.read"
    ],
    "withheld": [
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "rsbuild",
    "hostVersion": "2.2.11",
    "packageManager": "pnpm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "missing-project-vocabulary",
      "classificationRationale": "No recessed surface token exists; design-system.edit is granted.",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "The token is added with explicit overrides where inheritance (highContrast extends dark) would otherwise produce the wrong value."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import",
            "dom-global-access",
            "dynamic-code",
            "privileged-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-diff",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [
            "token:colors.bg.sunken"
          ],
          "removed": [],
          "changed": [
            "theme:dark",
            "theme:highContrast"
          ],
          "description": "One token added; only the dark and highContrast theme mappings change."
        },
        {
          "id": "light-sunken",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/TransferForm.tsx",
            "export": "TransferForm",
            "props": {},
            "theme": "light"
          },
          "select": {
            "testId": "transfer-form"
          },
          "expect": {
            "textMatches": "Amount",
            "styles": {
              "background-color": {
                "token": "colors.bg.sunken",
                "value": "#e2e8f0"
              }
            }
          },
          "description": "Light value."
        },
        {
          "id": "dark-sunken",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/components/TransferForm.tsx",
            "export": "TransferForm",
            "props": {},
            "theme": "dark"
          },
          "select": {
            "testId": "transfer-form"
          },
          "expect": {
            "styles": {
              "background-color": {
                "value": "#0f172a"
              }
            }
          },
          "description": "Dark override."
        },
        {
          "id": "hc-sunken",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/components/TransferForm.tsx",
            "export": "TransferForm",
            "props": {},
            "theme": "highContrast"
          },
          "select": {
            "testId": "transfer-form"
          },
          "expect": {
            "styles": {
              "background-color": {
                "value": "#000000"
              }
            }
          },
          "description": "highContrast must not inherit the dark value."
        }
      ]
    }
  }
}
