{
  "schemaVersion": 1,
  "id": "states-boundary-aria-disabled",
  "title": "Focusable disabled state through aria-disabled",
  "split": "development",
  "workflow": "states",
  "caseType": "boundary",
  "tags": [
    "host:vite",
    "project-shape:vite-react-storefront"
  ],
  "workspace": {
    "fixture": "vite-react-storefront",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/components/AddToCartButton.jsx"
    ],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "classificationRationale": "The disabled condition selector includes [aria-disabled=\"true\"].",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "The declared disabled condition already matches aria-disabled; only markup changes."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import",
            "dom-global-access",
            "dynamic-code",
            "privileged-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "disabled-state",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/components/AddToCartButton.jsx",
            "export": "AddToCartButton",
            "props": {
              "disabled": true
            }
          },
          "select": {
            "testId": "add-to-cart"
          },
          "expect": {
            "text": "Add to cart",
            "attributes": {
              "aria-disabled": "true",
              "disabled": null
            },
            "styles": {
              "opacity": {
                "value": "0.5"
              },
              "pointer-events": {
                "value": "none"
              }
            }
          },
          "description": "Disabled: aria-disabled, no native attribute, disabled look applied by the declared condition."
        },
        {
          "id": "enabled-state",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/components/AddToCartButton.jsx",
            "export": "AddToCartButton",
            "props": {
              "disabled": false
            }
          },
          "select": {
            "testId": "add-to-cart"
          },
          "expect": {
            "attributes": {
              "aria-disabled": null,
              "disabled": null
            },
            "styles": {
              "opacity": {
                "absent": true
              },
              "background-color": {
                "token": "colors.action.primary"
              }
            }
          },
          "description": "Enabled: no disabled attribute or look."
        },
        {
          "id": "hover-state",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/components/AddToCartButton.jsx",
            "export": "AddToCartButton",
            "props": {
              "disabled": false
            }
          },
          "select": {
            "testId": "add-to-cart"
          },
          "expect": {
            "styles": {
              "background-color": {
                "token": "colors.action.primaryHover"
              }
            }
          },
          "description": "Hover still uses the primary hover color.",
          "context": {
            "states": [
              "hover"
            ]
          }
        }
      ]
    }
  }
}
