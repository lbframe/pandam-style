{
  "schemaVersion": 1,
  "id": "discovery-positive-card-vocabulary",
  "title": "Report the card vocabulary needed for a compact featured card",
  "split": "development",
  "workflow": "discovery",
  "caseType": "positive",
  "tags": [
    "host:vite",
    "project-shape:vite-react-storefront",
    "read-only"
  ],
  "workspace": {
    "fixture": "vite-react-storefront",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "shell.exec"
    ],
    "granted": [
      "workspace.read",
      "shell.exec",
      "git.read"
    ],
    "withheld": [
      "workspace.write",
      "host.build",
      "host.dev-server",
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 600,
    "maxTurns": 30
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "read-only-report",
        "summary": "Exact recipe, slot, axis and token names are reported without modifying the workspace."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "none",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "report",
          "kind": "report.final",
          "class": "report",
          "required": true,
          "description": "Answers match the design-system definition exactly.",
          "answers": {
            "recipe": {
              "equals": "card"
            },
            "slots": {
              "equals": [
                "root",
                "header",
                "title",
                "body",
                "footer"
              ]
            },
            "elevations": {
              "setEquals": [
                "flat",
                "raised"
              ]
            },
            "compactRaisedRadiusToken": {
              "equals": "radii.sm"
            },
            "mutedTextToken": {
              "equals": "colors.text.muted"
            }
          }
        }
      ]
    }
  }
}
