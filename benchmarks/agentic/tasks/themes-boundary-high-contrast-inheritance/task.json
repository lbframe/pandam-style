{
  "schemaVersion": 1,
  "id": "themes-boundary-high-contrast-inheritance",
  "title": "Theme selection including an inheriting high-contrast theme",
  "split": "development",
  "workflow": "themes",
  "caseType": "boundary",
  "tags": [
    "host:rsbuild",
    "project-shape:rsbuild-ledger-ts"
  ],
  "workspace": {
    "fixture": "rsbuild-ledger-ts",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/App.tsx"
    ],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "rsbuild",
    "hostVersion": "2.2.11",
    "packageManager": "pnpm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "Three finite theme references, including one that extends another, are selected at the root."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "hc-canvas",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/App.tsx",
            "export": "App",
            "props": {
              "theme": "highContrast"
            }
          },
          "select": {
            "testId": "ledger-app"
          },
          "expect": {
            "styles": {
              "background-color": {
                "value": "#000000"
              },
              "color": {
                "value": "#ffffff"
              }
            }
          },
          "description": "High contrast overrides canvas and text."
        },
        {
          "id": "hc-inherited",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/App.tsx",
            "export": "App",
            "props": {
              "theme": "highContrast"
            }
          },
          "select": {
            "testId": "sync-alert-icon"
          },
          "expect": {
            "styles": {
              "color": {
                "token": "colors.feedback.caution",
                "value": "#d97706"
              }
            }
          },
          "description": "Tokens not overridden by highContrast or dark keep the base value."
        },
        {
          "id": "hc-panel",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/App.tsx",
            "export": "App",
            "props": {
              "theme": "highContrast"
            }
          },
          "select": {
            "testId": "sync-alert"
          },
          "expect": {
            "styles": {
              "background-color": {
                "value": "#000000"
              }
            }
          },
          "description": "Panel surface follows the highContrast override."
        },
        {
          "id": "dark-canvas",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/App.tsx",
            "export": "App",
            "props": {
              "theme": "dark"
            }
          },
          "select": {
            "testId": "ledger-app"
          },
          "expect": {
            "styles": {
              "background-color": {
                "value": "#0f172a"
              }
            }
          },
          "description": "Dark theme."
        },
        {
          "id": "light-default",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/App.tsx",
            "export": "App",
            "props": {}
          },
          "select": {
            "testId": "ledger-app"
          },
          "expect": {
            "styles": {
              "background-color": {
                "value": "#f8fafc"
              }
            }
          },
          "description": "Light default."
        }
      ]
    }
  }
}
