{
  "schemaVersion": 1,
  "id": "repair-boundary-non-static-selection",
  "title": "Repair a non-static recipe selection without behavior change",
  "split": "development",
  "workflow": "repair",
  "caseType": "boundary",
  "tags": [
    "host:vite",
    "project-shape:vite-react-hybrid"
  ],
  "workspace": {
    "fixture": "vite-react-hybrid",
    "git": "baseline-commit",
    "overlays": [
      "overlay"
    ]
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/ui/DestinationCard.jsx"
    ],
    "protected": [
      "design/system.mjs",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "notes": "Observed alpha1 behavior: an inline conditional over a destructured parameter with a default value inside a recipe selection is rejected as PMS_NON_STATIC_VALUE.",
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "PMS_NON_STATIC_VALUE is repaired locally (a finite local selection) while preserving the optional prop semantics."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "hot",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/ui/DestinationCard.jsx",
            "export": "DestinationCard",
            "props": {
              "name": "Porto",
              "hot": true
            }
          },
          "select": {
            "testId": "destination-chip"
          },
          "expect": {
            "text": "Trending",
            "styles": {
              "background-color": {
                "token": "colors.highlight"
              }
            }
          },
          "description": "hot=true selects the hot emphasis."
        },
        {
          "id": "not-hot",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/ui/DestinationCard.jsx",
            "export": "DestinationCard",
            "props": {
              "name": "Porto",
              "hot": false
            }
          },
          "select": {
            "testId": "destination-chip"
          },
          "expect": {
            "text": "Popular",
            "styles": {
              "background-color": {
                "token": "colors.surface.muted"
              }
            }
          },
          "description": "hot=false selects normal."
        },
        {
          "id": "omitted",
          "kind": "render.styles",
          "class": "behavioral",
          "required": true,
          "render": {
            "module": "src/ui/DestinationCard.jsx",
            "export": "DestinationCard",
            "props": {
              "name": "Porto"
            }
          },
          "select": {
            "testId": "destination-chip"
          },
          "expect": {
            "text": "Popular",
            "styles": {
              "background-color": {
                "token": "colors.surface.muted"
              }
            }
          },
          "description": "Omitted hot behaves as false."
        }
      ]
    }
  }
}
