{
  "schemaVersion": 1,
  "id": "migration-positive-price-tag",
  "title": "Migrate a legacy component onto an existing recipe",
  "split": "development",
  "workflow": "migration",
  "caseType": "positive",
  "tags": [
    "host:vite",
    "project-shape:vite-react-hybrid"
  ],
  "workspace": {
    "fixture": "vite-react-hybrid",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/ui/PriceTag.jsx",
      "src/Portal.jsx",
      "src/legacy/PriceTag.jsx",
      "src/legacy/PriceTag.module.css"
    ],
    "protected": [
      "design/system.mjs",
      ".pandamstyle/**"
    ],
    "allowDelete": true,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "classificationRationale": "Legacy values equal the chip recipe hot branch: coral background, white text, 999px radius, 14px, 12px inline padding.",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "The legacy pill maps one-to-one onto the chip recipe with hot emphasis."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "tag-parity",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/ui/PriceTag.jsx",
            "export": "PriceTag",
            "props": {
              "amount": 89
            }
          },
          "select": {
            "testId": "price-tag"
          },
          "expect": {
            "text": "from 89 EUR",
            "styles": {
              "background-color": {
                "token": "colors.highlight",
                "value": "#ef6f6c"
              },
              "color": {
                "value": "#ffffff"
              },
              "border-radius": {
                "value": "999px"
              },
              "font-size": {
                "value": "14px"
              },
              "padding-inline": {
                "value": "12px"
              },
              "display": {
                "value": "inline-flex"
              }
            }
          },
          "description": "Every legacy declaration resolves to the same value through system vocabulary."
        },
        {
          "id": "portal-wired",
          "kind": "files.contains",
          "class": "scope",
          "required": true,
          "path": "src/Portal.jsx",
          "description": "Portal uses the migrated component.",
          "patterns": [
            "from '\\./ui/PriceTag(\\.jsx)?'"
          ],
          "absent": [
            "legacy/PriceTag"
          ]
        },
        {
          "id": "legacy-removed",
          "kind": "files.contains",
          "class": "scope",
          "required": true,
          "path": "src/legacy/PriceTag.module.css",
          "description": "Legacy stylesheet removed after parity.",
          "exists": false
        }
      ]
    }
  }
}
