{
  "schemaVersion": 1,
  "id": "composition-boundary-ambiguous-settings",
  "title": "Underspecified restyling request",
  "split": "development",
  "workflow": "composition",
  "caseType": "boundary",
  "tags": [
    "ambiguous-request",
    "host:next-webpack",
    "project-shape:next-webpack-console"
  ],
  "workspace": {
    "fixture": "next-webpack-console",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "app/settings/page.jsx"
    ],
    "protected": [
      "design.pandamstyle.config.mjs",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      ".next/**",
      ".pandamstyle-next-host/**",
      "next-env.d.ts"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "next-webpack",
    "hostVersion": "16.3.8",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 600,
    "maxTurns": 30
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "clarification",
        "summary": "The request does not identify which visual properties should change; the agent asks before editing."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "none",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "report",
          "kind": "report.final",
          "class": "report",
          "required": true,
          "description": "The agent asks which visual aspects should change instead of guessing a redesign.",
          "outcome": [
            "needs-decision"
          ],
          "gaps": {
            "require": [
              {
                "kind": "ambiguous-request",
                "subject": "."
              }
            ]
          }
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        }
      ]
    }
  }
}
