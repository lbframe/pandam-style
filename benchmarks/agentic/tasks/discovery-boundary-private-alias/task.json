{
  "schemaVersion": 1,
  "id": "discovery-boundary-private-alias",
  "title": "Map a private palette color from a design spec to its public token",
  "split": "development",
  "workflow": "discovery",
  "caseType": "boundary",
  "tags": [
    "host:rsbuild",
    "project-shape:rsbuild-ledger-ts",
    "read-only"
  ],
  "workspace": {
    "fixture": "rsbuild-ledger-ts",
    "git": "baseline-commit"
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "shell.exec"
    ],
    "granted": [
      "workspace.read",
      "shell.exec",
      "git.read"
    ],
    "withheld": [
      "workspace.write",
      "host.build",
      "host.dev-server",
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "rsbuild",
    "hostVersion": "2.2.11",
    "packageManager": "pnpm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 600,
    "maxTurns": 30
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "classificationRationale": "The private palette value has a public semantic alias used by the field recipe.",
      "intendedOutcome": {
        "kind": "read-only-report",
        "summary": "colors.teal600 is private; the public focus alias colors.line.focus and condition focusVisible are reported."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "none",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "report",
          "kind": "report.final",
          "class": "report",
          "required": true,
          "description": "The public semantic alias (not the private palette entry) and the declared condition are reported.",
          "answers": {
            "focusToken": {
              "equals": "colors.line.focus"
            },
            "focusCondition": {
              "equals": "focusVisible"
            }
          }
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        }
      ]
    }
  }
}
