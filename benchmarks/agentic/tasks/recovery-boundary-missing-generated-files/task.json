{
  "schemaVersion": 1,
  "id": "recovery-boundary-missing-generated-files",
  "title": "Partially deleted generated output",
  "split": "development",
  "workflow": "recovery",
  "caseType": "boundary",
  "tags": [
    "adversarial:generated-output",
    "host:vite",
    "project-shape:vite-react-minimal"
  ],
  "workspace": {
    "fixture": "vite-react-minimal",
    "git": "baseline-commit",
    "prepare": [
      {
        "step": "compile"
      },
      {
        "step": "delete",
        "path": "pandamstyle/generated/manifest.json"
      },
      {
        "step": "delete",
        "path": "pandamstyle/generated/design.pandamstyle.d.ts"
      }
    ]
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [],
    "protected": [
      "pandamstyle/system.js",
      "pandamstyle/generated/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      "pandamstyle/generated/**",
      "pandamstyle/.generated.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "The missing artifacts are regenerated by the compiler, never written by hand."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "any",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "generated-regenerated",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "must-match",
          "description": "Generated design-system output is present and byte-identical to fresh compiler output."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import",
            "dom-global-access",
            "dynamic-code",
            "privileged-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "notes-render",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/NotesApp.jsx",
            "export": "NotesApp"
          },
          "select": {
            "testId": "notes-app"
          },
          "expect": {
            "textMatches": "Groceries[\\s\\S]*Ideas",
            "styles": {
              "background-color": {
                "token": "colors.surface.base"
              }
            }
          },
          "description": "Fresh compiler output renders the app (source sanity)."
        }
      ]
    }
  }
}
