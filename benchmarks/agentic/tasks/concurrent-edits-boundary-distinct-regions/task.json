{
  "schemaVersion": 1,
  "id": "concurrent-edits-boundary-distinct-regions",
  "title": "Concurrent edits to different regions of the same file",
  "split": "development",
  "workflow": "concurrent-edits",
  "caseType": "boundary",
  "tags": [
    "host:rsbuild",
    "project-shape:rsbuild-ledger-ts"
  ],
  "workspace": {
    "fixture": "rsbuild-ledger-ts",
    "git": "baseline-commit",
    "events": [
      {
        "id": "memo-field",
        "trigger": {
          "type": "after-tool-calls",
          "count": 2
        },
        "description": "A teammate adds a memo input after the amount field.",
        "steps": [
          {
            "step": "replace",
            "path": "src/components/TransferForm.tsx",
            "find": "      </label>\n    </form>",
            "replace": "      </label>\n      <input data-testid=\"memo-input\" name=\"memo\" placeholder=\"Memo\" />\n    </form>"
          }
        ]
      }
    ]
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/components/TransferForm.tsx"
    ],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "rsbuild",
    "hostVersion": "2.2.11",
    "packageManager": "pnpm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "Both the requested change and the concurrent change in another region are present in the final file."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "event-applied",
          "kind": "observation.runner",
          "class": "environment",
          "required": true,
          "observation": "event:memo-field",
          "expect": "applied",
          "invalidatesRun": true,
          "description": "Harness precondition: the concurrent edit was applied during the run."
        },
        {
          "id": "memo-kept",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/TransferForm.tsx",
            "export": "TransferForm",
            "props": {}
          },
          "select": {
            "testId": "memo-input"
          },
          "expect": {},
          "description": "The teammate's memo field survives."
        },
        {
          "id": "hint-text",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/TransferForm.tsx",
            "export": "TransferForm",
            "props": {}
          },
          "select": {
            "testId": "amount-hint"
          },
          "expect": {
            "text": "Transfers settle in one to two business days.",
            "styles": {
              "color": {
                "token": "colors.fg.subtle"
              }
            }
          },
          "description": "Requested hint text with unchanged styling."
        }
      ]
    }
  }
}
