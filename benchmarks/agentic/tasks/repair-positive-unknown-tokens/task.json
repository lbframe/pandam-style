{
  "schemaVersion": 1,
  "id": "repair-positive-unknown-tokens",
  "title": "Repair unknown token references after a refactor",
  "split": "development",
  "workflow": "repair",
  "caseType": "positive",
  "tags": [
    "adversarial:invent-token",
    "host:vite",
    "project-shape:vite-react-storefront",
    "reference-oracle-fixture"
  ],
  "workspace": {
    "fixture": "vite-react-storefront",
    "git": "baseline-commit",
    "overlays": [
      "overlay"
    ]
  },
  "prompt": "prompt.md",
  "permissions": {
    "writable": [
      "src/components/PromoBanner.jsx"
    ],
    "protected": [
      "design.pandamstyle.config.js",
      ".pandamstyle/**"
    ],
    "allowDelete": false,
    "harnessIgnored": [
      ".pandamstyle/**",
      "..pandamstyle.pms-state.json",
      "dist/**"
    ]
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build"
    ],
    "granted": [
      "workspace.read",
      "workspace.write",
      "shell.exec",
      "host.build",
      "git.read"
    ],
    "withheld": [
      "design-system.edit",
      "package.install",
      "network.registry",
      "git.write"
    ]
  },
  "environment": {
    "node": "22.22.0",
    "host": "vite",
    "hostVersion": "8.3.1",
    "packageManager": "npm",
    "install": "before-agent",
    "pandamstyle": "candidate-packages",
    "network": "none",
    "browser": false,
    "resources": [
      "pandamstyle-agent-docs"
    ]
  },
  "budget": {
    "timeoutSeconds": 900,
    "maxTurns": 60
  },
  "expectations": {
    "alpha1": {
      "classification": "expressible",
      "intendedOutcome": {
        "kind": "application-success",
        "summary": "Both diagnostics (PMS_UNKNOWN_TOKEN) are repaired locally with existing tokens."
      },
      "checks": [
        {
          "id": "scope",
          "kind": "scope.diff",
          "class": "scope",
          "required": true,
          "expectChanges": "some",
          "description": "Every workspace change matches the permitted files; protected paths are untouched."
        },
        {
          "id": "compile",
          "kind": "compile.project",
          "class": "compile",
          "required": true,
          "expect": "ok",
          "description": "A fresh compile of the final sources through the Project Service succeeds (necessary, never sufficient)."
        },
        {
          "id": "no-bypass",
          "kind": "static.forbidden",
          "class": "static",
          "required": true,
          "rules": [
            "jsx-style-prop",
            "runtime-style-injection",
            "css-in-js-import",
            "stylesheet-import",
            "raw-classname",
            "type-escape",
            "direct-pandamstyle-import",
            "generated-internal-import",
            "dom-global-access",
            "dynamic-code",
            "privileged-import"
          ],
          "description": "No newly introduced raw style channel, runtime style injection, stylesheet, CSS-in-JS, type escape or generated-internal import."
        },
        {
          "id": "generated-untouched",
          "kind": "generated.consistent",
          "class": "integrity",
          "required": true,
          "mode": "no-hand-edits",
          "description": "Generated design-system output is either untouched or byte-identical to fresh compiler output."
        },
        {
          "id": "vocabulary-unchanged",
          "kind": "definition.diff",
          "class": "integrity",
          "required": true,
          "added": [],
          "removed": [],
          "changed": [],
          "description": "The design-system vocabulary (tokens, conditions, themes, recipes) is unchanged."
        },
        {
          "id": "banner-surface",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/PromoBanner.jsx",
            "export": "PromoBanner"
          },
          "select": {
            "testId": "promo-banner"
          },
          "expect": {
            "styles": {
              "background-color": {
                "token": "colors.surface.raised"
              },
              "border-radius": {
                "token": "radii.md"
              }
            }
          },
          "description": "Raised surface restored."
        },
        {
          "id": "banner-text",
          "kind": "render.styles",
          "class": "rendered",
          "required": true,
          "render": {
            "module": "src/components/PromoBanner.jsx",
            "export": "PromoBanner"
          },
          "select": {
            "tag": "p",
            "within": {
              "testId": "promo-banner"
            }
          },
          "expect": {
            "text": "Free shipping on orders over 50 EUR.",
            "styles": {
              "font-size": {
                "token": "fontSizes.md"
              }
            }
          },
          "description": "Body font size restored."
        }
      ]
    }
  }
}
